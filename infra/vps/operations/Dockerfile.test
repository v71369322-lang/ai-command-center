# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN --mount=type=secret,id=proxy_ca \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
      python3 python3-cryptography openssl && rm -rf /var/lib/apt/lists/*
# Test-only identities, not changes to the cloud host or VPS.
RUN if id ubuntu >/dev/null 2>&1; then userdel ubuntu; fi; \
    if getent group ubuntu >/dev/null 2>&1; then groupdel ubuntu; fi; \
    groupadd -g 1000 acc-control && useradd -u 1000 -g 1000 -M acc-control && \
    groupadd -g 1001 acc-exec && useradd -u 1001 -g 1001 -M acc-exec && \
    groupadd -g 2000 acc-gh-runner && useradd -u 2000 -g 2000 -M acc-gh-runner
COPY --chmod=0555 src/command_center/operations_channel.py src/command_center/__init__.py /opt/proof/src/command_center/
COPY --chmod=0555 infra/vps/operations/submit.py /opt/proof/submit.py
COPY --chmod=0555 infra/vps/operations/container_proof.py /opt/proof/proof.py
ENV PYTHONPATH=/opt/proof/src PYTHONDONTWRITEBYTECODE=1
ARG F1_SOURCE_REVISION
LABEL org.opencontainers.image.revision=$F1_SOURCE_REVISION
CMD ["python3", "/opt/proof/proof.py"]
