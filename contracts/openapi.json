{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "default": 120,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Seconds",
            "type": "integer"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "AssertionRequest": {
        "additionalProperties": false,
        "properties": {
          "assertion": {
            "maxLength": 7000,
            "minLength": 32,
            "title": "Assertion",
            "type": "string"
          }
        },
        "required": [
          "assertion"
        ],
        "title": "AssertionRequest",
        "type": "object"
      },
      "Command": {
        "additionalProperties": false,
        "properties": {
          "cost": {
            "default": 0,
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Cost",
            "type": "integer"
          },
          "dependency": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9-]{36}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dependency"
          },
          "kind": {
            "default": "render",
            "enum": [
              "render",
              "approved_render"
            ],
            "title": "Kind",
            "type": "string"
          },
          "values": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 16,
            "minProperties": 1,
            "title": "Values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "title": "Command",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ResumeRequest": {
        "additionalProperties": false,
        "properties": {
          "checkpoint_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checkpoint Digest",
            "type": "string"
          },
          "epoch": {
            "minimum": 1.0,
            "title": "Epoch",
            "type": "integer"
          }
        },
        "required": [
          "epoch",
          "checkpoint_digest"
        ],
        "title": "ResumeRequest",
        "type": "object"
      }
    }
  },
